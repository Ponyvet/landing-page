---
const {
  title = "Ponyvet | Veterinaria a domicilio para comunidades rurales",
  description =
    "Atención veterinaria móvil para ganado, equinos y mascotas rurales con visitas programadas directamente en tu comunidad.",
} = Astro.props;
const fontHref =
  "https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0891B2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;

    /* Brand scale */
    --pv-teal-900: #053a4a;
    --pv-teal-800: #065e75;
    --pv-teal-700: #077693;
    --pv-teal-600: #0891b2;
    --pv-teal-500: #22a3c2;
    --pv-teal-300: #7dcbdd;
    --pv-teal-100: #d5eef4;
    --pv-teal-50: #eef8fb;
    --pv-navy-900: #0f1f33;
    --pv-navy-800: #162c48;
    --pv-navy-700: #1e3a5f;
    --pv-navy-500: #33547d;
    --pv-navy-400: #6a86a4;
    --pv-navy-300: #8ea4bd;
    --pv-gold-600: #b8834b;
    --pv-gold-500: #c79561;
    --pv-gold-400: #d4a574;
    --pv-gold-200: #e8cfae;
    --pv-gold-100: #f4e8da;
    --pv-line: #dbe6ea;

    /* Semantic */
    --background: #fafcfd;
    --foreground: #1e3a5f;
    --card: #ffffff;
    --card-foreground: var(--foreground);
    --primary: var(--pv-teal-600);
    --primary-foreground: #fafafa;
    --secondary: #eef6f8;
    --secondary-foreground: var(--foreground);
    --muted-foreground: #5b6b80;
    --accent: var(--pv-gold-400);
    --accent-foreground: #402c17;
    --border: var(--pv-line);

    /* Radius */
    --radius: 0.625rem;
    --radius-sm: calc(var(--radius) - 4px);
    --radius-md: calc(var(--radius) - 2px);
    --radius-lg: var(--radius);
    --radius-xl: calc(var(--radius) + 4px);
    --radius-2xl: calc(var(--radius) + 8px);
    --radius-full: 9999px;

    /* Elevation */
    --shadow-xs: 0 1px 2px 0 rgb(15 31 51 / 0.05);
    --shadow-sm:
      0 1px 3px 0 rgb(15 31 51 / 0.08), 0 1px 2px -1px rgb(15 31 51 / 0.06);
    --shadow-md:
      0 4px 6px -1px rgb(15 31 51 / 0.08), 0 2px 4px -2px rgb(15 31 51 / 0.06);
    --shadow-lg:
      0 10px 15px -3px rgb(15 31 51 / 0.1), 0 4px 6px -4px rgb(15 31 51 / 0.06);

    /* Motion */
    --duration-fast: 150ms;
    --duration: 200ms;
    --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
    --transition-control:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);

    /* Typography */
    --font-sans:
      ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
      "Helvetica Neue", Arial, sans-serif;
    --font-display: "Montserrat", var(--font-sans);
    --text-xs: 0.75rem;
    --text-sm: 0.875rem;
    --text-base: 1rem;
    --text-lg: 1.125rem;
    --text-xl: 1.25rem;
    --text-2xl: 1.5rem;
    --text-3xl: 1.875rem;
    --text-4xl: 2.25rem;
    --text-5xl: 3rem;
    --leading-tight: 1.25;
    --leading-snug: 1.375;
    --leading-normal: 1.5;
    --weight-medium: 500;
    --weight-semibold: 600;
    --weight-bold: 700;
    --weight-extrabold: 800;
    --tracking-tight: -0.02em;
    --tracking-wide: 0.06em;

    /* Layout */
    --section-max: 72rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: var(--font-sans);
    background: var(--background);
    color: var(--foreground);
    min-height: 100vh;
    line-height: 1.6;
  }

  .page {
    position: relative;
    overflow-x: hidden;
  }

  a {
    color: inherit;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  strong {
    font-weight: var(--weight-semibold);
  }

  ::selection {
    background: var(--pv-teal-100);
  }
</style>
