---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import Hero from "@components/Hero.astro";
import HighlightsSection from "@components/HighlightsSection.astro";
import ServiceCatalogSection from "@components/ServiceCatalogSection.astro";
import HowItWorksSection from "@components/HowItWorksSection.astro";
import BenefitsSection from "@components/BenefitsSection.astro";
import CoverageSection from "@components/CoverageSection.astro";
import FinalCTA from "@components/FinalCTA.astro";
import SiteFooter from "@components/SiteFooter.astro";
import companyInfo from "../data/company-info.json";

const { company, contact } = companyInfo;

const whatsappLink = contact.whatsapp.link;
const pageTitle = company.seo.title;
const pageDescription = company.seo.description;
const currentYear = new Date().getFullYear();
---

<Layout title={pageTitle} description={pageDescription}>
  <SiteHeader brandName={company.name} whatsappLink={whatsappLink} />
  <main>
    <Hero
      tagline={company.tagline}
      description={company.description}
      stats={company.statistics}
      whatsappLink={whatsappLink}
      phoneNumber={contact.phone.international}
      phoneDisplay={contact.phone.display}
      baseLocation={company.baseLocation}
      coverageRadius={company.coverage.radius}
    />
    <HighlightsSection highlights={company.highlights} />
    <ServiceCatalogSection services={company.servicesCatalog} />
    <HowItWorksSection />
    <BenefitsSection />
    <CoverageSection coverage={company.coverage} serviceHours={company.serviceHours} />
    <FinalCTA contact={contact} />
  </main>
  <SiteFooter
    companyName={company.name}
    description={company.description}
    contact={contact}
    coverageAreas={company.coverage.areas}
    currentYear={currentYear}
  />
</Layout>
