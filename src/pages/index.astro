---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const phoneNumber = '+524461234567';
const phoneDisplay = '(446) 123 4567';
const whatsappLink = 'https://wa.me/524461234567';
const email = 'contacto@ponyvet.mx';
const pageTitle = 'Ponyvet | Veterinaria a domicilio para comunidades rurales';
const pageDescription =
        'Atención veterinaria móvil para ganado, equinos y mascotas en zonas rurales del Valle Verde. Consultas preventivas, apoyo en urgencias dentro del horario y planes sanitarios sin salir del predio.';
const currentYear = new Date().getFullYear();
---
<Layout title={pageTitle} description={pageDescription}>
        <header class="site-header">
                <div class="logo">Ponyvet</div>
                <nav class="nav-links" aria-label="Navegación principal">
                        <a href="#inicio">Inicio</a>
                        <a href="#servicios">Servicios</a>
                        <a href="#como-funciona">Cómo funciona</a>
                        <a href="#beneficios">Beneficios</a>
                        <a href="#testimonios">Testimonios</a>
                        <a href="#cobertura">Cobertura</a>
                </nav>
                <a class="contact-phone" href={`tel:${phoneNumber}`}>Llámanos de 8 a 19 h al {phoneDisplay}</a>
        </header>
        <main>
                <section class="hero" id="inicio">
                        <div class="hero-content">
                                <span class="eyebrow">Veterinaria rural a domicilio</span>
                                <h1>Ponyvet llega a tu rancho para cuidar a tus animales</h1>
                                <p>
                                        Consultas preventivas, seguimiento sanitario y atención a urgencias dentro de nuestro horario extendido.
                                        Nuestro equipo móvil llega directamente a tu rancho o comunidad con el equipamiento necesario.
                                </p>
                                <div class="cta-group">
                                        <a class="cta primary" href={whatsappLink} target="_blank" rel="noopener noreferrer">
                                                <Icon name="message-circle" class="icon" size={20} aria-hidden="true" />
                                                Agenda por WhatsApp
                                        </a>
                                        <a class="cta secondary" href="#servicios">
                                                <Icon name="arrow-down" class="icon" size={20} aria-hidden="true" />
                                                Ver servicios
                                        </a>
                                </div>
                                <ul class="hero-highlights">
                                        <li>
                                                <Icon name="check" class="list-icon" size={18} aria-hidden="true" />
                                                Respuesta garantizada en menos de 24 horas dentro del Valle Verde
                                        </li>
                                        <li>
                                                <Icon name="check" class="list-icon" size={18} aria-hidden="true" />
                                                Clínica móvil equipada para ganado, equinos y mascotas rurales
                                        </li>
                                        <li>
                                                <Icon name="check" class="list-icon" size={18} aria-hidden="true" />
                                                Atendemos de lunes a domingo de 8:00 a 19:00 hrs
                                        </li>
                                </ul>
                        </div>
                        <div class="hero-card">
                                <h2>Equipo veterinario móvil Ponyvet</h2>
                                <p>Programamos visitas y atendemos urgencias dentro del horario sin que traslades a tus animales.</p>
                                <dl class="stats">
                                        <div>
                                                <dt>+350</dt>
                                                <dd>visitas a campo cada año</dd>
                                        </div>
                                        <div>
                                                <dt>96%</dt>
                                                <dd>casos resueltos sin traslado</dd>
                                        </div>
                                </dl>
                                <p class="small">Horario de atención: 8:00 a 19:00 hrs, todos los días.</p>
                        </div>
                </section>

                <section id="servicios" class="services">
                        <div class="section-heading">
                                <h2>Servicios veterinarios a domicilio</h2>
                                <p>
                                        Diseñados para productores y familias rurales que necesitan soluciones inmediatas y confiables sin mover a sus
                                        animales.
                                </p>
                        </div>
                        <div class="services-grid">
                                <article class="service-card">
                                        <div class="service-icon" aria-hidden="true">
                                                <Icon name="clipboard-check" size={24} strokeWidth={1.8} />
                                        </div>
                                        <h3>Consultas preventivas y planes sanitarios</h3>
                                        <p>
                                                Calendarios de vacunación, desparasitación y chequeos generales para mantener al hato saludable todo el año.
                                        </p>
                                </article>
                                <article class="service-card">
                                        <div class="service-icon" aria-hidden="true">
                                                <Icon name="briefcase-medical" size={24} strokeWidth={1.8} />
                                        </div>
                                        <h3>Emergencias y cirugías de campo</h3>
                                        <p>
                                                Atención prioritaria dentro del horario extendido para partos complicados, lesiones y procedimientos menores
                                                sin trasladar al animal.
                                        </p>
                                </article>
                                <article class="service-card">
                                        <div class="service-icon" aria-hidden="true">
                                                <Icon name="beaker" size={24} strokeWidth={1.8} />
                                        </div>
                                        <h3>Laboratorio y diagnóstico móvil</h3>
                                        <p>Pruebas rápidas, análisis sanguíneo y evaluación nutricional con entrega de resultados en sitio.</p>
                                </article>
                                <article class="service-card">
                                        <div class="service-icon" aria-hidden="true">
                                                <Icon name="paw-print" size={24} strokeWidth={1.8} />
                                        </div>
                                        <h3>Atención a mascotas rurales</h3>
                                        <p>Vacunas, esterilización y control de enfermedades zoonóticas para perros y gatos que viven en el campo.</p>
                                </article>
                        </div>
                </section>

                <section id="como-funciona" class="how-it-works">
                        <div class="section-heading">
                                <h2>Así funciona nuestro servicio</h2>
                                <p>Estamos listos para acompañarte en cada etapa, desde la llamada inicial hasta el seguimiento posterior.</p>
                        </div>
                        <ol class="steps">
                                <li>
                                        <span class="step-number">1</span>
                                        <h3>Solicita una visita</h3>
                                        <p>Agenda por WhatsApp o teléfono y cuéntanos qué animales requieren atención.</p>
                                </li>
                                <li>
                                        <span class="step-number">2</span>
                                        <h3>Llegamos preparados</h3>
                                        <p>Un médico veterinario especializado se desplaza con el equipamiento necesario para resolver en el predio.</p>
                                </li>
                                <li>
                                        <span class="step-number">3</span>
                                        <h3>Seguimiento continuo</h3>
                                        <p>Recibe recomendaciones y recordatorios digitales para mantener al día la salud de tu hato.</p>
                                </li>
                        </ol>
                </section>

                <section id="beneficios" class="benefits">
                        <div class="section-heading">
                                <h2>¿Por qué elegir Ponyvet?</h2>
                                <p>Diseñamos cada visita pensando en los caminos de terracería y las distancias largas de las comunidades rurales.</p>
                        </div>
                        <ul class="feature-list">
                                <li>
                                        <h3>Equipo especializado rural</h3>
                                        <p>Veterinarios con experiencia en producción bovina, caprina y equina, certificados en medicina preventiva.</p>
                                </li>
                                <li>
                                        <h3>Transparencia y seguimiento</h3>
                                        <p>Reportes digitales después de cada visita, historial compartido y recordatorios de vacunación sin costo extra.</p>
                                </li>
                                <li>
                                        <h3>Planes flexibles</h3>
                                        <p>Paquetes mensuales y atención por evento para adaptarnos a las necesidades de cada rancho o comunidad.</p>
                                </li>
                        </ul>
                </section>

                <section id="testimonios" class="testimonials-section">
                        <div class="section-heading">
                                <h2>Productores que confían en nosotros</h2>
                                <p>Historias reales de ranchos y comunidades rurales donde la salud animal es clave para la familia.</p>
                        </div>
                        <div class="testimonial-grid">
                                <figure class="testimonial-card">
                                        <blockquote>
                                                “Desde que Ponyvet nos visita cada mes, bajamos los casos de mastitis y mejoramos la producción de leche sin
                                                salir del rancho.”
                                        </blockquote>
                                        <figcaption>
                                                María López
                                                <span>Rancho El Encino, Valle Verde</span>
                                        </figcaption>
                                </figure>
                                <figure class="testimonial-card">
                                        <blockquote>
                                                “Ponyvet acude rápido en urgencias y mantiene a la cooperativa informada con reportes claros. Son parte de nuestro
                                                equipo.”
                                        </blockquote>
                                        <figcaption>
                                                Cooperativa San Miguel
                                                <span>Productores de caprinos</span>
                                        </figcaption>
                                </figure>
                                <figure class="testimonial-card">
                                        <blockquote>
                                                “El laboratorio móvil de Ponyvet nos da resultados al momento. Así podemos tomar decisiones sin perder días de
                                                trabajo.”
                                        </blockquote>
                                        <figcaption>
                                                Pedro Hernández
                                                <span>Comunidad La Esperanza</span>
                                        </figcaption>
                                </figure>
                        </div>
                </section>

                <section id="cobertura" class="coverage">
                        <div class="coverage-text">
                                <h2>Zona de cobertura</h2>
                                <p>
                                        Atendemos ranchos, ejidos y comunidades dentro de un radio de 50 km alrededor del Valle Verde. Llegamos por caminos de
                                        terracería con unidades 4x4 y kits completos de atención.
                                </p>
                                <ul class="coverage-list">
                                        <li>Valle Verde</li>
                                        <li>San Miguel de la Sierra</li>
                                        <li>La Esperanza</li>
                                        <li>Rancho El Encino</li>
                                        <li>Puente de Piedra</li>
                                        <li>Santa Lucía</li>
                                </ul>
                                <span class="coverage-badge">Sin costo de desplazamiento hasta 30 km</span>
                        </div>
                        <div class="coverage-panels">
                                <div class="panel">
                                        <h3>Horarios de visita</h3>
                                        <ul>
                                                <li>Lunes a domingo: 8:00 - 19:00 hrs</li>
                                                <li>Visitas programadas y atención urgente dentro del horario</li>
                                                <li>Confirmación previa vía WhatsApp</li>
                                        </ul>
                                </div>
                                <div class="panel">
                                        <h3>Contactos directos</h3>
                                        <p>Resolvemos dudas y programamos visitas durante el horario de atención.</p>
                                        <a href={`tel:${phoneNumber}`}>Llamada directa {phoneDisplay}</a>
                                        <a href={whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp de 8:00 a 19:00 hrs</a>
                                        <a href={`mailto:${email}`}>{email}</a>
                                </div>
                        </div>
                </section>

                <section id="contacto" class="cta-final">
                        <h2>Coordinemos la próxima visita de Ponyvet</h2>
                        <p>
                                Agenda hoy mismo y asegura el bienestar de tu ganado, caballos o mascotas rurales. Nuestro equipo recorre tu comunidad
                                de lunes a domingo entre las 8:00 y las 19:00 hrs.
                        </p>
                        <div class="cta-group">
                                <a class="cta primary" href={whatsappLink} target="_blank" rel="noopener noreferrer">
                                        <Icon name="message-circle" class="icon" size={20} aria-hidden="true" />
                                        Reservar por WhatsApp
                                </a>
                                <a class="cta secondary" href={`mailto:${email}`}>
                                        <Icon name="mail" class="icon" size={20} aria-hidden="true" />
                                        Escríbenos un correo
                                </a>
                        </div>
                </section>
        </main>

        <footer>
                <div class="footer-inner">
                        <div>
                                <div class="footer-logo">Ponyvet</div>
                                <p class="footer-description">
                                        Veterinaria móvil especializada en comunidades rurales del Valle Verde. Contigo los siete días de la semana.
                                </p>
                        </div>
                        <nav class="footer-nav" aria-label="Navegación secundaria">
                                <a href="#inicio">Inicio</a>
                                <a href="#servicios">Servicios</a>
                                <a href="#como-funciona">Cómo funciona</a>
                                <a href="#beneficios">Beneficios</a>
                                <a href="#testimonios">Testimonios</a>
                                <a href="#cobertura">Cobertura</a>
                                <a href="#contacto">Contacto</a>
                        </nav>
                        <div class="footer-contact">
                                <span>Teléfono: <a href={`tel:${phoneNumber}`}>{phoneDisplay}</a></span>
                                <span>WhatsApp (8:00 a 19:00 h): <a href={whatsappLink} target="_blank" rel="noopener noreferrer">{phoneDisplay}</a></span>
                                <span>Correo: <a href={`mailto:${email}`}>{email}</a></span>
                                <span>Ubicación base: Valle Verde, Querétaro</span>
                        </div>
                </div>
                <p class="footer-meta">© {currentYear} Ponyvet. Todos los derechos reservados.</p>
        </footer>
</Layout>

<style>
        .site-header {
                width: min(1100px, 92vw);
                margin: 0 auto;
                padding: 1.5rem 0 0;
                display: flex;
                align-items: center;
                gap: 1.5rem;
                flex-wrap: wrap;
                justify-content: space-between;
        }

        .logo {
                font-size: 1.75rem;
                font-weight: 700;
                color: var(--primary);
                letter-spacing: -0.02em;
        }

        .nav-links {
                display: flex;
                gap: 1.5rem;
                align-items: center;
                flex-wrap: wrap;
        }

        .nav-links a {
                font-weight: 500;
                color: var(--muted);
                text-decoration: none;
                font-size: 0.95rem;
                transition: color 0.2s ease;
        }

        .nav-links a:hover {
                color: var(--primary);
        }

        .contact-phone {
                margin-left: auto;
                background: var(--primary);
                color: #fff;
                text-decoration: none;
                padding: 0.75rem 1.4rem;
                border-radius: 999px;
                font-weight: 600;
                box-shadow: var(--shadow);
                transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
        }

        .contact-phone:hover {
                transform: translateY(-2px);
                background: var(--primary-dark);
                box-shadow: 0 20px 45px -35px rgba(26, 77, 104, 0.6);
        }

        main {
                display: flex;
                flex-direction: column;
                gap: 6rem;
                padding: 2rem 0 6rem;
        }

        .hero {
                width: min(1100px, 92vw);
                margin: 0 auto;
                padding-top: 2rem;
                display: grid;
                gap: 3rem;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                align-items: center;
        }

        .hero-content {
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
        }

        .eyebrow {
                text-transform: uppercase;
                letter-spacing: 0.2em;
                font-size: 0.75rem;
                font-weight: 600;
                color: var(--primary);
        }

        .hero-content h1 {
                margin: 0;
                font-size: clamp(2.45rem, 2.4rem + 1vw, 3.4rem);
                line-height: 1.1;
                letter-spacing: -0.02em;
        }

        .hero-content p {
                margin: 0;
                color: var(--muted);
                font-size: 1.05rem;
        }

        .cta-group {
                display: flex;
                flex-wrap: wrap;
                gap: 1rem;
                margin: 2rem 0;
        }

        .cta {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.85rem 1.6rem;
                border-radius: 999px;
                font-weight: 600;
                text-decoration: none;
                transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease, color 0.25s ease;
        }

        .cta.primary {
                background: var(--primary);
                color: #fff;
                box-shadow: var(--shadow);
        }

        .cta.primary:hover {
                transform: translateY(-2px);
                background: var(--primary-dark);
        }

        .cta.secondary {
                background: rgba(42, 111, 151, 0.12);
                color: var(--primary-dark);
        }

        .cta.secondary:hover {
                background: rgba(42, 111, 151, 0.22);
        }

        .cta .icon {
                width: 1.1rem;
                height: 1.1rem;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
        }

        .hero-highlights {
                margin: 0;
                padding: 0;
                list-style: none;
                display: grid;
                gap: 0.75rem;
        }

        .hero-highlights li {
                background: var(--surface);
                border-radius: 16px;
                padding: 0.75rem 1rem;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                box-shadow: 0 18px 40px -30px rgba(17, 34, 44, 0.45);
                font-weight: 500;
        }

        .hero-highlights .list-icon {
                width: 1.45rem;
                height: 1.45rem;
                border-radius: 50%;
                background: rgba(42, 111, 151, 0.12);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.2rem;
                color: var(--primary);
        }

        .hero-card {
                position: relative;
                overflow: hidden;
                background: linear-gradient(155deg, #2a6f97 0%, #1e4d68 90%);
                color: #eff6fa;
                padding: 2.5rem;
                border-radius: 28px;
                box-shadow: 0 32px 60px -40px rgba(14, 40, 56, 0.65);
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
        }

        .hero-card::after {
                content: '';
                position: absolute;
                width: 240px;
                height: 240px;
                border-radius: 50%;
                background: rgba(242, 166, 90, 0.25);
                top: -70px;
                right: -80px;
        }

        .hero-card h2 {
                margin: 0;
                font-size: 2rem;
                letter-spacing: -0.01em;
        }

        .hero-card p {
                margin: 0;
                color: rgba(239, 247, 250, 0.85);
        }

        .hero-card .stats {
                display: grid;
                gap: 1.5rem;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                margin: 0;
        }

        .hero-card .stats div {
                display: flex;
                flex-direction: column;
                gap: 0.25rem;
        }

        .hero-card dt {
                margin: 0;
                font-weight: 700;
                font-size: 2.4rem;
                color: #fff;
        }

        .hero-card dd {
                margin: 0;
                color: rgba(239, 247, 250, 0.75);
                font-size: 0.9rem;
        }

        .hero-card .small {
                font-size: 0.85rem;
                color: rgba(239, 247, 250, 0.7);
        }

        .services,
        .how-it-works,
        .benefits,
        .testimonials-section,
        .coverage,
        .cta-final {
                width: min(1100px, 92vw);
                margin: 0 auto;
        }

        .section-heading {
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                max-width: 60ch;
        }

        .section-heading h2 {
                margin: 0;
                font-size: clamp(1.9rem, 1.7rem + 0.7vw, 2.4rem);
                letter-spacing: -0.01em;
        }

        .section-heading p {
                margin: 0;
                color: var(--muted);
        }

        .services-grid {
                margin-top: 2.5rem;
                display: grid;
                gap: 1.5rem;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        }

        .service-card {
                background: var(--surface);
                border-radius: 24px;
                padding: 1.9rem;
                display: flex;
                flex-direction: column;
                gap: 1rem;
                box-shadow: 0 24px 60px -42px rgba(17, 34, 44, 0.45);
                position: relative;
                overflow: hidden;
        }

        .service-card::after {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: inherit;
                border: 1px solid rgba(42, 111, 151, 0.08);
                pointer-events: none;
        }

        .service-icon {
                width: 3rem;
                height: 3rem;
                border-radius: 16px;
                background: rgba(42, 111, 151, 0.12);
                display: grid;
                place-items: center;
                color: var(--primary);
        }

        .service-icon svg {
                width: 1.6rem;
                height: 1.6rem;
        }

        .service-card h3 {
                margin: 0;
                font-size: 1.2rem;
        }

        .service-card p {
                margin: 0;
                color: var(--muted);
                font-size: 0.98rem;
        }

        .steps {
                margin: 3rem 0 0;
                padding: 0;
                list-style: none;
                display: grid;
                gap: 1.5rem;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        }

        .steps li {
                background: var(--surface);
                border-radius: 22px;
                padding: 2.2rem 1.75rem 1.75rem;
                position: relative;
                box-shadow: 0 24px 60px -42px rgba(17, 34, 44, 0.45);
        }

        .step-number {
                position: absolute;
                top: -1.3rem;
                left: 1.75rem;
                width: 2.5rem;
                height: 2.5rem;
                border-radius: 50%;
                background: var(--accent);
                display: grid;
                place-items: center;
                font-weight: 700;
                color: var(--primary-dark);
                box-shadow: 0 12px 30px -20px rgba(242, 166, 90, 0.6);
        }

        .steps h3 {
                margin: 1rem 0 0.5rem;
                font-size: 1.1rem;
        }

        .steps p {
                margin: 0;
                color: var(--muted);
                font-size: 0.95rem;
        }

        .benefits {
                display: grid;
                gap: 2.5rem;
        }

        .feature-list {
                margin: 0;
                padding: 0;
                list-style: none;
                display: grid;
                gap: 1rem;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        }

        .feature-list li {
                background: var(--surface);
                border-radius: 20px;
                padding: 1.75rem;
                box-shadow: 0 24px 60px -42px rgba(17, 34, 44, 0.45);
                border-left: 5px solid var(--accent);
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
        }

        .feature-list h3 {
                margin: 0;
                font-size: 1.15rem;
        }

        .feature-list p {
                margin: 0;
                color: var(--muted);
                font-size: 0.95rem;
        }

        .testimonial-grid {
                display: grid;
                gap: 1.5rem;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
                margin-top: 2.5rem;
        }

        .testimonial-card {
                background: var(--surface);
                border-radius: 24px;
                padding: 1.9rem;
                box-shadow: 0 24px 60px -42px rgba(17, 34, 44, 0.45);
                display: flex;
                flex-direction: column;
                gap: 1.25rem;
        }

        blockquote {
                margin: 0;
                font-size: 1.05rem;
                color: var(--text);
                line-height: 1.6;
                font-style: italic;
        }

        figcaption {
                font-weight: 600;
                color: var(--primary-dark);
        }

        figcaption span {
                display: block;
                font-size: 0.85rem;
                color: var(--muted);
                margin-top: 0.2rem;
                font-weight: 500;
        }

        .coverage {
                display: grid;
                gap: 2rem;
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                align-items: start;
        }

        .coverage-text {
                background: var(--surface);
                border-radius: 28px;
                padding: 2.5rem;
                box-shadow: 0 28px 70px -45px rgba(17, 34, 44, 0.45);
                display: flex;
                flex-direction: column;
