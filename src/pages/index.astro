---
import Layout from "../layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import HeroSection from "@components/HeroSection.astro";
import ServicesSection from "@components/ServicesSection.astro";
import HowItWorksSection from "@components/HowItWorksSection.astro";
import BenefitsSection from "@components/BenefitsSection.astro";
import TestimonialsSection from "@components/TestimonialsSection.astro";
import CoverageSection from "@components/CoverageSection.astro";
import FinalCTA from "@components/FinalCTA.astro";
import SiteFooter from "@components/SiteFooter.astro";

const phoneNumber = "+524461234567";
const phoneDisplay = "(446) 123 4567";
const whatsappLink = "https://wa.me/524461234567";
const email = "contacto@ponyvet.mx";
const pageTitle = "Ponyvet | Veterinaria a domicilio para comunidades rurales";
const pageDescription =
  "Atención veterinaria móvil para ganado, equinos y mascotas en zonas rurales del Valle Verde. Consultas preventivas, apoyo en urgencias dentro del horario y planes sanitarios sin salir del predio.";
const currentYear = new Date().getFullYear();
---

<Layout title={pageTitle} description={pageDescription}>
  <Navbar phoneNumber={phoneNumber} phoneDisplay={phoneDisplay} />
  <main>
    <HeroSection whatsappLink={whatsappLink} />
    <ServicesSection />
    <HowItWorksSection />
    <BenefitsSection />
    <TestimonialsSection />
    <CoverageSection
      phoneNumber={phoneNumber}
      phoneDisplay={phoneDisplay}
      whatsappLink={whatsappLink}
      email={email}
    />
    <FinalCTA whatsappLink={whatsappLink} email={email} />
  </main>
  <SiteFooter
    phoneNumber={phoneNumber}
    phoneDisplay={phoneDisplay}
    whatsappLink={whatsappLink}
    email={email}
    currentYear={currentYear}
  />
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 6rem;
    padding: 2rem 0 6rem;
  }
</style>
