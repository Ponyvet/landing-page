---
import Layout from "../layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import HeroSection from "@components/HeroSection.astro";
import ServicesSection from "@components/ServicesSection.astro";
import HowItWorksSection from "@components/HowItWorksSection.astro";
import BenefitsSection from "@components/BenefitsSection.astro";
import TestimonialsSection from "@components/TestimonialsSection.astro";
import CoverageSection from "@components/CoverageSection.astro";
import FinalCTA from "@components/FinalCTA.astro";
import SiteFooter from "@components/SiteFooter.astro";
import companyInfo from "../data/company-info.json";

const { company, contact } = companyInfo;

const phoneNumber = contact.phone.international;
const phoneDisplay = contact.phone.display;
const whatsappLink = contact.whatsapp.link;
const email = contact.email;
const pageTitle = company.seo.title;
const pageDescription = company.seo.description;
const currentYear = new Date().getFullYear();
---

<Layout title={pageTitle} description={pageDescription}>
  <Navbar
    brandName={company.name}
    phoneNumber={phoneNumber}
    phoneDisplay={phoneDisplay}
  />
  <main>
    <HeroSection
      companyName={company.name}
      tagline={company.tagline}
      description={company.description}
      highlights={company.highlights}
      stats={company.statistics}
      whatsappLink={whatsappLink}
      serviceHours={company.serviceHours}
    />
    <ServicesSection />
    <HowItWorksSection />
    <BenefitsSection />
    <TestimonialsSection />
    <CoverageSection
      coverage={company.coverage}
      serviceHours={company.serviceHours}
      contact={contact}
      baseLocation={company.baseLocation}
    />
    <FinalCTA contact={contact} serviceHours={company.serviceHours} />
  </main>
  <SiteFooter
    companyName={company.name}
    tagline={company.tagline}
    description={company.description}
    contact={contact}
    baseLocation={company.baseLocation}
    currentYear={currentYear}
  />
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 6rem;
    padding: 2rem 0 6rem;
  }
</style>
