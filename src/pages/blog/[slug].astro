---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const pageTitle = `${post.data.title} | Blog Ponyvet`;
const pageDescription = post.data.description;
const formattedDate = post.data.pubDate.toLocaleDateString("es-MX", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="blog-post">
    <article>
      <a class="back-link" href="/blog">← Volver al blog</a>
      <header class="post-header">
        <p class="post-eyebrow">Blog Ponyvet</p>
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          <span aria-hidden="true">•</span>
          <span>{post.data.author}</span>
        </div>
        {post.data.tags.length > 0 && (
          <ul class="post-tags">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}
        {post.data.heroImage && (
          <figure class="post-hero">
            <img
              src={post.data.heroImage}
              alt={`Imagen del artículo ${post.data.title}`}
              loading="lazy"
            />
          </figure>
        )}
      </header>
      <div class="post-content">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  .blog-post {
    width: min(760px, 92vw);
    margin: 0 auto;
    padding: 3rem 0 5rem;
  }

  article {
    background: var(--surface);
    border-radius: 1.5rem;
    box-shadow: var(--shadow);
    padding: clamp(1.75rem, 4vw, 2.5rem);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .post-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0;
  }

  .post-header h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 2.6rem);
    line-height: 1.2;
  }

  .post-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .post-meta time {
    font-weight: 600;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-tags li {
    background: rgba(42, 111, 151, 0.1);
    color: var(--primary);
    font-weight: 600;
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    text-transform: lowercase;
  }

  .post-hero {
    margin: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 18px 48px -32px rgba(17, 34, 44, 0.45);
  }

  .post-hero img {
    width: 100%;
    display: block;
  }

  .post-content {
    display: grid;
    gap: 1.5rem;
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    margin: 0;
    color: var(--primary-dark);
  }

  .post-content :global(h2) {
    font-size: 1.7rem;
  }

  .post-content :global(h3) {
    font-size: 1.3rem;
  }

  .post-content :global(p) {
    margin: 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0;
    padding-left: 1.35rem;
    display: grid;
    gap: 0.5rem;
  }

  .post-content :global(li) {
    margin: 0;
  }

  .post-content :global(a) {
    color: var(--primary);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    article {
      padding: 1.5rem;
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
