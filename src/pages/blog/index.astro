---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = "Blog veterinario rural | Ponyvet";
const pageDescription =
  "Consejos prácticos para el cuidado de animales en comunidades rurales, escritos por el equipo de Ponyvet.";

const formatDate = (date: Date) =>
  date.toLocaleDateString("es-MX", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="blog-page">
    <section class="intro">
      <p class="eyebrow">Blog Ponyvet</p>
      <h1>Historias y consejos para cuidar a tu comunidad rural</h1>
      <p>
        Aquí encontrarás artículos redactados en formato markdown por nuestro equipo veterinario. Cada publicación comparte
        aprendizajes y recomendaciones listas para aplicar en el día a día de tu rancho o ejido.
      </p>
    </section>

    <section class="posts" aria-label="Listado de artículos del blog">
      {posts.length > 0 ? (
        posts.map((post) => {
          const formattedDate = formatDate(post.data.pubDate);
          return (
            <article class="post-card">
              <a class="post-card__link" href={`/blog/${post.slug}/`}>
                <div class="post-card__body">
                  <div class="post-card__meta">
                    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                    {post.data.tags.length > 0 && (
                      <ul class="post-card__tags">
                        {post.data.tags.slice(0, 3).map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                </div>
                <span class="post-card__cta">Leer artículo →</span>
              </a>
            </article>
          );
        })
      ) : (
        <p class="empty-state">
          Aún no hay artículos publicados. Muy pronto compartiremos novedades y recomendaciones del equipo Ponyvet.
        </p>
      )}
    </section>
  </main>
</Layout>

<style>
  .blog-page {
    width: min(960px, 92vw);
    margin: 0 auto;
    padding: 4rem 0 6rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .intro {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .intro .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0;
  }

  .intro h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 700;
  }

  .intro p {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .post-card {
    background: var(--surface);
    border-radius: 1.25rem;
    box-shadow: var(--shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    overflow: hidden;
  }

  .post-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    padding: 1.75rem;
    gap: 1.5rem;
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .post-card__meta time {
    font-weight: 600;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-card__tags li {
    background: rgba(42, 111, 151, 0.1);
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    text-transform: lowercase;
  }

  .post-card h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .post-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .post-card__cta {
    font-weight: 600;
    color: var(--primary);
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 60px -44px rgba(17, 34, 44, 0.35);
  }

  .empty-state {
    grid-column: 1 / -1;
    margin: 0;
    background: rgba(42, 111, 151, 0.08);
    color: var(--primary-dark);
    border-radius: 1rem;
    padding: 2rem;
    font-weight: 500;
    text-align: center;
  }

  @media (max-width: 640px) {
    .blog-page {
      padding: 3rem 0 4rem;
      gap: 2.5rem;
    }

    .post-card__link {
      padding: 1.5rem;
    }

    .post-card__meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
