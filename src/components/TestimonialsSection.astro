---
const testimonials = [
  {
    quote:
      "“Desde que Ponyvet nos visita cada mes, bajamos los casos de mastitis y mejoramos la producción de leche sin salir del rancho.”",
    author: "María López",
    role: "Comunidad San Salvador",
  },
  {
    quote:
      "“Ponyvet acude rápido en urgencias y mantiene a la cooperativa informada con reportes claros. Son parte de nuestro equipo.”",
    author: "Javier Ramírez",
    role: "Productor agropecuario",
  },
  {
    quote:
      "“El laboratorio móvil de Ponyvet nos da resultados al momento. Así podemos tomar decisiones sin perder días de trabajo.”",
    author: "Pedro Hernández",
    role: "Comunidad Francisco I. Madero",
  },
];
---

<section id="testimonios" class="testimonials-section">
  <div class="section-heading">
    <h2>Productores que confían en nosotros</h2>
    <p>
      Historias reales de ranchos y comunidades rurales donde la salud animal es
      clave para la familia.
    </p>
  </div>
  <div class="testimonial-grid">
    {
      testimonials.map((testimonial) => (
        <figure class="testimonial-card">
          <blockquote>{testimonial.quote}</blockquote>
          <figcaption>
            {testimonial.author}
            <span>{testimonial.role}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .testimonials-section {
    width: min(1100px, 92vw);
    margin: 0 auto;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 60ch;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.9rem, 1.7rem + 0.7vw, 2.4rem);
    letter-spacing: -0.01em;
  }

  .section-heading p {
    margin: 0;
    color: var(--muted);
  }

  .testimonial-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin-top: 2.5rem;
  }

  .testimonial-card {
    background: var(--surface);
    border-radius: 24px;
    padding: 1.9rem;
    box-shadow: 0 24px 60px -42px rgba(17, 34, 44, 0.45);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  blockquote {
    margin: 0;
    font-size: 1.05rem;
    color: var(--text);
    line-height: 1.6;
    font-style: italic;
  }

  figcaption {
    font-weight: 600;
    color: var(--primary-dark);
  }

  figcaption span {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.2rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .testimonial-card {
      padding: 1.5rem;
    }
  }
</style>
