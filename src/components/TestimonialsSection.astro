---
import Section from "@components/ui/Section.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";

const testimonials = [
  {
    quote:
      "Desde que Ponyvet nos visita cada mes, bajamos los casos de mastitis y mejoramos la producción de leche sin salir del rancho.",
    author: "María López",
    role: "Comunidad San Salvador",
  },
  {
    quote:
      "Ponyvet acude rápido en urgencias y mantiene a la cooperativa informada con reportes claros. Son parte de nuestro equipo.",
    author: "Javier Ramírez",
    role: "Productor agropecuario",
  },
  {
    quote:
      "El laboratorio móvil de Ponyvet nos da resultados al momento. Así podemos tomar decisiones sin perder días de trabajo.",
    author: "Pedro Hernández",
    role: "Comunidad Francisco I. Madero",
  },
];
---

<Section id="testimonios" background="muted" ariaLabel="Testimonios">
  <SectionTitle
    eyebrow="Testimonios"
    title="Productores que confían en nosotros"
    lead="Historias reales de ranchos y comunidades rurales donde la salud animal es clave para la familia."
  />
  <div class="testimonial-layout">
    <figure class="testimonial-featured">
      <blockquote>“{testimonials[0].quote}”</blockquote>
      <figcaption>
        {testimonials[0].author}
        <span>{testimonials[0].role}</span>
      </figcaption>
    </figure>
    <div class="testimonial-minor-list">
      {testimonials.slice(1).map((testimonial) => (
        <figure class="testimonial-minor">
          <blockquote>“{testimonial.quote}”</blockquote>
          <figcaption>
            {testimonial.author}
            <span>{testimonial.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</Section>

<style>
  .testimonial-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .testimonial-featured {
    position: relative;
    margin: 0;
    padding: 0.5rem 0 0 2.75rem;
  }

  .testimonial-featured::before {
    content: "“";
    position: absolute;
    top: -1.75rem;
    left: -0.25rem;
    font-family: var(--font-display);
    font-size: 6rem;
    font-weight: var(--weight-bold);
    color: var(--pv-teal-100);
    line-height: 1;
  }

  .testimonial-featured blockquote {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    line-height: 1.35;
    letter-spacing: var(--tracking-tight);
    color: var(--pv-navy-700);
  }

  .testimonial-featured figcaption {
    position: relative;
    margin-top: 1.25rem;
    font-weight: var(--weight-semibold);
    color: var(--pv-navy-700);
  }

  .testimonial-minor-list {
    display: grid;
  }

  .testimonial-minor {
    margin: 0;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }

  .testimonial-minor:last-child {
    border-bottom: 1px solid var(--border);
  }

  .testimonial-minor blockquote {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    font-style: italic;
    color: var(--foreground);
  }

  .testimonial-minor figcaption {
    margin-top: 0.75rem;
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    color: var(--pv-navy-700);
  }

  figcaption span {
    display: block;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    margin-top: 2px;
    font-weight: var(--weight-medium);
  }

  .testimonial-minor figcaption span {
    font-size: var(--text-xs);
  }

  @media (max-width: 860px) {
    .testimonial-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .testimonial-featured {
      padding-left: 2rem;
    }

    .testimonial-featured blockquote {
      font-size: var(--text-xl);
    }
  }
</style>
