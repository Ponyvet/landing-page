---
import Section from "@components/ui/Section.astro";
import Button from "@components/ui/Button.astro";

type ContactDetails = {
  whatsapp?: { link?: string };
  email?: string;
};

interface Props {
  contact?: ContactDetails;
}

const { contact } = Astro.props satisfies Props;

const whatsappLink = contact?.whatsapp?.link ?? "https://wa.me/527721541841";
const email = contact?.email ?? "clinica.ponyvet@gmail.com";
---

<Section id="contacto" background="navy" ariaLabel="Contacto">
  <div class="cta-grid">
    <div class="cta-text">
      <h2>Agenda tu cita previa vía WhatsApp</h2>
      <p>Atendemos de 08:00 a 19:00, los siete días de la semana.</p>
    </div>
    <div class="cta-buttons">
      <Button
        size="lg"
        icon="whatsapp"
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp
      </Button>
      <Button size="lg" variant="outline" icon="mail" href={`mailto:${email}`} class="cta-email">
        {email}
      </Button>
    </div>
  </div>
</Section>

<style>
  .cta-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: center;
  }

  .cta-text {
    display: grid;
    gap: 12px;
  }

  .cta-text h2 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
  }

  .cta-text p {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.75);
  }

  .cta-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Repeated class beats Button's own higher-specificity scoped rules. */
  :global(.cta-email.cta-email.cta-email) {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }

  :global(.cta-email.cta-email.cta-email:hover) {
    background: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 900px) {
    .cta-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .cta-buttons {
      justify-content: center;
    }
  }
</style>
