---
import Icon from "@components/Icon.astro";

type ServiceHours = {
  days?: string;
  opening?: string;
  closing?: string;
};

type ContactDetails = {
  whatsapp?: {
    link?: string;
    hours?: string | null;
  };
  email?: string;
};

type FinalCTAProps = {
  contact?: ContactDetails;
  serviceHours?: ServiceHours;
};

const { contact, serviceHours } = Astro.props satisfies FinalCTAProps;

const formatServiceWindow = (
  hours: ServiceHours | null | undefined,
): string | null => {
  if (!hours) return null;
  const { days, opening, closing } = hours;

  if (days && opening && closing) {
    return `de ${days.toLowerCase()} entre las ${opening} y las ${closing} hrs`;
  }

  if (opening && closing) {
    return `entre las ${opening} y las ${closing} hrs`;
  }

  return days ? `de ${days.toLowerCase()}` : null;
};

const formatContactHours = (value: string | null | undefined): string | null => {
  if (!value) return null;
  const trimmed = value.trim();

  if (trimmed.includes("-")) {
    const [start, end] = trimmed.split("-").map((segment) => segment.trim());
    if (start && end) {
      return `${start} a ${end} hrs`;
    }
  }

  return trimmed;
};

const serviceWindowLabel =
  formatServiceWindow(serviceHours) ??
  "de lunes a domingo entre las 8:00 y las 19:00 hrs";

const whatsappLink =
  contact?.whatsapp?.link ?? "https://wa.me/524461234567";
const email = contact?.email ?? "contacto@ponyvet.mx";
const whatsappHoursLabel = formatContactHours(contact?.whatsapp?.hours ?? null);
---


<section id="contacto" class="cta-final">
  <h2>Coordinemos la próxima visita de Ponyvet</h2>
  <p>
    Agenda hoy mismo y asegura el bienestar de tu ganado, caballos o mascotas
    rurales. Nuestro equipo recorre tu comunidad {serviceWindowLabel}.
  </p>
  <div class="cta-group">
    <a
      class="cta primary"
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      title={
        whatsappHoursLabel
          ? `Horario de WhatsApp: ${whatsappHoursLabel}`
          : undefined
      }
    >
      <Icon name="message-circle" class="icon" size={20} aria-hidden="true" />
      Reservar por WhatsApp
    </a>
    <a class="cta secondary" href={`mailto:${email}`}>
      <Icon name="mail" class="icon" size={20} aria-hidden="true" />
      Escríbenos un correo
    </a>
  </div>
</section>

<style>
  .cta-final {
    width: min(1100px, 92vw);
    margin: 0 auto;
    margin-top: 1rem;
    background: linear-gradient(145deg, #1e4d68 0%, #16364b 100%);
    color: #eaf4fb;
    padding: 4rem 2rem;
    border-radius: 36px;
    text-align: center;
    box-shadow: 0 36px 80px -48px rgba(14, 40, 56, 0.78);
  }

  .cta-final h2 {
    margin: 0;
    font-size: clamp(2rem, 1.8rem + 0.8vw, 2.6rem);
  }

  .cta-final p {
    margin: 1rem auto 2.5rem;
    max-width: 48ch;
    color: rgba(234, 244, 251, 0.85);
  }

  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease,
      color 0.25s ease;
  }

  .cta.primary {
    background: var(--primary);
    color: #fff;
    box-shadow: var(--shadow);
  }

  .cta.primary:hover {
    transform: translateY(-2px);
    background: var(--primary-dark);
  }

  .cta.secondary {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.32);
  }

  .cta.secondary:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  .cta .icon {
    width: 1.1rem;
    height: 1.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .cta-group {
      flex-direction: column;
      align-items: stretch;
    }

    .cta {
      justify-content: center;
      width: 100%;
    }
  }
</style>
