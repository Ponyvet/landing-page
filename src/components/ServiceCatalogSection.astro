---
import Section from "@components/ui/Section.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import IconCircle from "@components/ui/IconCircle.astro";

type ServiceItem = { name: string; type: string; animals: string[] };

interface Props {
  services?: ServiceItem[];
}

const { services = [] } = Astro.props satisfies Props;

const speciesMeta: Record<
  string,
  { slug: string; label: string; icon: string; blurb: string }
> = {
  Perros: {
    slug: "perros",
    label: "Perros",
    icon: "dog",
    blurb: "Cirugía, vacunación y desparasitación para tu compañero de casa.",
  },
  Gatos: {
    slug: "gatos",
    label: "Gatos",
    icon: "cat",
    blurb: "Esterilización y cuidado preventivo felino.",
  },
  Bovinos: {
    slug: "bovinos",
    label: "Bovinos",
    icon: "beef",
    blurb: "Tratamiento y seguimiento sanitario para el hato.",
  },
  Porcinos: {
    slug: "porcinos",
    label: "Porcinos",
    icon: "piggy-bank",
    blurb: "Inseminación, vacunación y manejo reproductivo de la piara.",
  },
  Ovinos: {
    slug: "ovinos",
    label: "Ovinos",
    icon: "paw-print",
    blurb: "Partos, desparasitación y tratamiento para el rebaño.",
  },
  Aves: {
    slug: "aves",
    label: "Aves",
    icon: "bird",
    blurb: "Vacunación para parvadas de traspatio.",
  },
  General: {
    slug: "general",
    label: "Atención general",
    icon: "stethoscope",
    blurb: "Consultas y urgencias para cualquier especie.",
  },
};

const typeOrder = [
  "Consulta",
  "Vacunación",
  "Desparasitación",
  "Prevención",
  "Cirugía",
  "Tratamiento",
  "Medicación",
  "Inseminación",
  "Otros",
];

const groups = Object.keys(speciesMeta)
  .map((species) => {
    const items = services
      .filter((service) => service.animals.includes(species))
      .slice()
      .sort((a, b) => typeOrder.indexOf(a.type) - typeOrder.indexOf(b.type));
    return { ...speciesMeta[species], items };
  })
  .filter((group) => group.items.length > 0);
---

<Section id="catalogo" background="muted" ariaLabel="Catálogo de servicios">
  <SectionTitle
    eyebrow="Catálogo"
    title="Servicios por tipo de animal"
    lead="Elige una especie para ver cirugías, vacunación, tratamientos y consultas disponibles."
  />

  <div class="catalog-shell">
    {
      groups.map((group, index) => (
        <input
          type="radio"
          name="catalog-species"
          id={`tab-${group.slug}`}
          class="tab-input"
          checked={index === 0}
        />
      ))
    }

    <div class="species-rail" aria-label="Filtrar catálogo por especie">
      {
        groups.map((group) => (
          <label for={`tab-${group.slug}`} class="rail-tab" data-species={group.slug}>
            <IconCircle name={group.icon} size={18} />
            <span class="rail-tab-text">
              <span class="rail-tab-name">{group.label}</span>
              <span class="rail-tab-count">
                {group.items.length} {group.items.length === 1 ? "servicio" : "servicios"}
              </span>
            </span>
          </label>
        ))
      }
    </div>

    <div class="panels">
      {
        groups.map((group) => (
          <div class="panel" data-species={group.slug}>
            <div class="panel-header">
              <IconCircle name={group.icon} size={26} />
              <div>
                <h3 class="panel-title">{group.label}</h3>
                <p class="panel-blurb">{group.blurb}</p>
              </div>
            </div>
            <ul class="service-list">
              {group.items.map((item) => (
                <li class="service-row">
                  <span class="service-name">{item.name}</span>
                  <span class="service-leader" aria-hidden="true" />
                  <span class="service-type">{item.type}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .catalog-shell {
    position: relative;
    display: grid;
    grid-template-columns: 260px 1fr;
    align-items: start;
    gap: 1.5rem;
  }

  .tab-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .species-rail {
    display: grid;
    align-content: start;
    gap: 4px;
  }

  .rail-tab {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-lg);
    border: 1px solid transparent;
    cursor: pointer;
    transition: var(--transition-control);
  }

  .rail-tab:hover {
    background: color-mix(in oklch, var(--card) 70%, transparent);
  }

  .rail-tab-text {
    display: grid;
    gap: 1px;
  }

  .rail-tab-name {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--foreground);
  }

  .rail-tab-count {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .panels {
    min-width: 0;
  }

  .panel {
    display: none;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    padding: 1.75rem;
  }

  .panel-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 1.25rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .panel-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--foreground);
  }

  .panel-blurb {
    margin: 2px 0 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .service-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .service-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 0.45rem 0;
  }

  .service-name {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--foreground);
    white-space: nowrap;
  }

  .service-leader {
    flex: 1 1 auto;
    min-width: 16px;
    border-bottom: 1px dotted var(--border);
    margin-bottom: 5px;
  }

  .service-type {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--primary);
    white-space: nowrap;
  }

  /* Active tab wiring, driven entirely by :checked state via :has() */
  .catalog-shell:has(#tab-perros:checked) .panel[data-species="perros"],
  .catalog-shell:has(#tab-gatos:checked) .panel[data-species="gatos"],
  .catalog-shell:has(#tab-bovinos:checked) .panel[data-species="bovinos"],
  .catalog-shell:has(#tab-porcinos:checked) .panel[data-species="porcinos"],
  .catalog-shell:has(#tab-ovinos:checked) .panel[data-species="ovinos"],
  .catalog-shell:has(#tab-aves:checked) .panel[data-species="aves"],
  .catalog-shell:has(#tab-general:checked) .panel[data-species="general"] {
    display: block;
    animation: panel-in 320ms var(--ease-standard);
  }

  .catalog-shell:has(#tab-perros:checked) .rail-tab[data-species="perros"],
  .catalog-shell:has(#tab-gatos:checked) .rail-tab[data-species="gatos"],
  .catalog-shell:has(#tab-bovinos:checked) .rail-tab[data-species="bovinos"],
  .catalog-shell:has(#tab-porcinos:checked) .rail-tab[data-species="porcinos"],
  .catalog-shell:has(#tab-ovinos:checked) .rail-tab[data-species="ovinos"],
  .catalog-shell:has(#tab-aves:checked) .rail-tab[data-species="aves"],
  .catalog-shell:has(#tab-general:checked) .rail-tab[data-species="general"] {
    background: var(--card);
    border-color: var(--border);
    box-shadow: var(--shadow-xs);
  }

  .catalog-shell:has(#tab-perros:checked) .rail-tab[data-species="perros"] .rail-tab-name,
  .catalog-shell:has(#tab-gatos:checked) .rail-tab[data-species="gatos"] .rail-tab-name,
  .catalog-shell:has(#tab-bovinos:checked) .rail-tab[data-species="bovinos"] .rail-tab-name,
  .catalog-shell:has(#tab-porcinos:checked) .rail-tab[data-species="porcinos"] .rail-tab-name,
  .catalog-shell:has(#tab-ovinos:checked) .rail-tab[data-species="ovinos"] .rail-tab-name,
  .catalog-shell:has(#tab-aves:checked) .rail-tab[data-species="aves"] .rail-tab-name,
  .catalog-shell:has(#tab-general:checked) .rail-tab[data-species="general"] .rail-tab-name {
    color: var(--primary);
  }

  .catalog-shell:has(#tab-perros:focus-visible) .rail-tab[data-species="perros"],
  .catalog-shell:has(#tab-gatos:focus-visible) .rail-tab[data-species="gatos"],
  .catalog-shell:has(#tab-bovinos:focus-visible) .rail-tab[data-species="bovinos"],
  .catalog-shell:has(#tab-porcinos:focus-visible) .rail-tab[data-species="porcinos"],
  .catalog-shell:has(#tab-ovinos:focus-visible) .rail-tab[data-species="ovinos"],
  .catalog-shell:has(#tab-aves:focus-visible) .rail-tab[data-species="aves"],
  .catalog-shell:has(#tab-general:focus-visible) .rail-tab[data-species="general"] {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes panel-in {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  @media (max-width: 860px) {
    .catalog-shell {
      grid-template-columns: 1fr;
    }

    .species-rail {
      grid-auto-flow: column;
      justify-content: start;
      overflow-x: auto;
      padding-bottom: 4px;
      -webkit-overflow-scrolling: touch;
    }

    .rail-tab {
      flex-shrink: 0;
      border-radius: var(--radius-full);
    }

    .panel {
      padding: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .service-row {
      flex-wrap: wrap;
      row-gap: 2px;
    }

    .service-name {
      white-space: normal;
    }

    .service-leader {
      display: none;
    }

    .service-type {
      flex-basis: 100%;
    }
  }
</style>
