---
import { Icon } from "astro-icon/components";
import IconRow from "@components/ui/IconRow.astro";

type ContactDetails = {
  phone?: { international?: string; display?: string };
  whatsapp?: { link?: string };
  email?: string;
  baseLocation?: string;
  facebook?: string;
};

interface Props {
  companyName?: string;
  description?: string[];
  contact?: ContactDetails;
  coverageAreas?: string[];
  currentYear?: number;
}

const {
  companyName = "Ponyvet",
  description = [],
  contact,
  coverageAreas = [],
  currentYear,
} = Astro.props satisfies Props;

const phoneDisplay = contact?.phone?.display ?? "(772) 154-1841";
const whatsappLink = contact?.whatsapp?.link ?? "https://wa.me/527721541841";
const whatsappHandle = whatsappLink.replace("https://", "");
const email = contact?.email ?? "clinica.ponyvet@gmail.com";
const baseLocation = contact?.baseLocation ?? "San Salvador, Hidalgo, México";
const facebookLink = contact?.facebook;
const displayYear = currentYear ?? new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <img src="/brand/logo-white.png" alt={companyName} class="footer-logo" />
      {description.map((paragraph) => <p>{paragraph}</p>)}
      <div class="social-links">
        <a
          class="social-link"
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
        >
          <Icon name="simple-icons:whatsapp" size={18} />
        </a>
        {facebookLink && (
          <a
            class="social-link"
            href={facebookLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <Icon name="simple-icons:facebook" size={18} />
          </a>
        )}
      </div>
    </div>
    <div class="footer-column">
      <span class="footer-heading">Contacto</span>
      <IconRow icon="phone">{phoneDisplay}</IconRow>
      <IconRow icon="message-circle">{whatsappHandle}</IconRow>
      <IconRow icon="mail">{email}</IconRow>
      <IconRow icon="map-pin">{baseLocation}</IconRow>
    </div>
    <div class="footer-column">
      <span class="footer-heading">Cobertura</span>
      {coverageAreas.map((area) => <span class="footer-area">{area}</span>)}
    </div>
  </div>
  <p class="footer-meta">
    © {displayYear} {companyName} Veterinaria · Lunes a domingo, 08:00–19:00
  </p>
</footer>

<style>
  .site-footer {
    background: var(--pv-navy-900);
    color: rgba(255, 255, 255, 0.75);
    padding: 3.5rem 1.5rem 2.5rem;
  }

  .footer-grid {
    max-width: var(--section-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 2.5rem;
  }

  .footer-brand {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .footer-logo {
    height: 72px;
    width: auto;
  }

  .footer-brand p {
    font-size: var(--text-sm);
    max-width: 24rem;
    margin: 0;
  }

  .social-links {
    display: flex;
    gap: 10px;
  }

  .social-link {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    transition: var(--transition-control);
  }

  .social-link:hover {
    background: var(--primary);
    text-decoration: none;
  }

  .footer-column {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .footer-heading {
    color: #fff;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .footer-area {
    font-size: var(--text-sm);
  }

  .footer-meta {
    max-width: var(--section-max);
    margin: 2.5rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: var(--text-xs);
  }

  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-brand {
      justify-items: center;
    }

    .footer-column {
      justify-items: center;
    }
  }
</style>
