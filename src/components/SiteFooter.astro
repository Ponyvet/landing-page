---
type ContactPhone = {
  international?: string;
  display?: string;
  hours?: string | null;
};

type ContactWhatsapp = {
  link?: string;
  hours?: string | null;
  notes?: string;
};

type ContactDetails = {
  phone?: ContactPhone;
  whatsapp?: ContactWhatsapp;
  email?: string;
  baseLocation?: string;
};

type BaseLocation = {
  community?: string;
  state?: string;
};

type SiteFooterProps = {
  companyName?: string;
  tagline?: string;
  description?: string[];
  contact?: ContactDetails;
  baseLocation?: BaseLocation;
  currentYear?: number;
};

const {
  companyName = "Ponyvet",
  tagline = "Veterinaria rural a domicilio",
  description = [],
  contact,
  baseLocation,
  currentYear,
} = Astro.props satisfies SiteFooterProps;

const formatContactHours = (value: string | null | undefined): string | null => {
  if (!value) return null;
  const trimmed = value.trim();

  if (trimmed.includes("-")) {
    const [start, end] = trimmed.split("-").map((segment) => segment.trim());
    if (start && end) {
      return `${start} a ${end} hrs`;
    }
  }

  return trimmed;
};

const phoneNumber = contact?.phone?.international ?? "+524461234567";
const phoneDisplay = contact?.phone?.display ?? "(446) 123 4567";
const phoneHoursLabel = formatContactHours(contact?.phone?.hours ?? null);

const whatsappLink = contact?.whatsapp?.link ?? "https://wa.me/524461234567";
const whatsappHoursLabel = formatContactHours(contact?.whatsapp?.hours ?? null);

const email = contact?.email ?? "contacto@ponyvet.mx";

const contactLocation =
  contact?.baseLocation ??
  (baseLocation?.community && baseLocation?.state
    ? `${baseLocation.community}, ${baseLocation.state}`
    : "Valle Verde, Querétaro");

const summaryParagraphs: string[] =
  description.length > 0
    ? description
    : [
        "Veterinaria móvil especializada en comunidades rurales del Valle Verde. Contigo los siete días de la semana.",
      ];

const displayYear = currentYear ?? new Date().getFullYear();
---


<footer>
  <div class="footer-inner">
    <div>
      <div class="footer-logo">{companyName}</div>
      <span class="footer-tagline">{tagline}</span>
      {summaryParagraphs.map((text) => (
        <p class="footer-description">{text}</p>
      ))}
    </div>
    <nav class="footer-nav" aria-label="Navegación secundaria">
      <a href="#inicio">Inicio</a>
      <a href="#servicios">Servicios</a>
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#beneficios">Beneficios</a>
      <a href="#testimonios">Testimonios</a>
      <a href="#cobertura">Cobertura</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <div class="footer-contact">
      {phoneNumber && phoneDisplay && (
        <span>
          Teléfono{phoneHoursLabel && ` (${phoneHoursLabel})`}:
          {' '}
          <a href={`tel:${phoneNumber}`}>{phoneDisplay}</a>
        </span>
      )}
      {whatsappLink && phoneDisplay && (
        <span>
          WhatsApp{whatsappHoursLabel && ` (${whatsappHoursLabel})`}:
          {' '}
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
            {phoneDisplay}
          </a>
        </span>
      )}
      {email && (
        <span>
          Correo:
          {' '}
          <a href={`mailto:${email}`}>{email}</a>
        </span>
      )}
      {contact?.whatsapp?.notes && <span>{contact.whatsapp.notes}</span>}
      {contactLocation && <span>Ubicación base: {contactLocation}</span>}
    </div>
  </div>
  <p class="footer-meta">
    © {displayYear} {companyName}. Todos los derechos reservados.
  </p>
</footer>

<style>
  footer {
    background: #112433;
    color: #d7e4ef;
    padding: 3rem 0 2rem;
    margin-top: 6rem;
  }

  .footer-inner {
    width: min(1100px, 92vw);
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    align-items: start;
  }

  .footer-logo {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .footer-tagline {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f4f9fb;
    opacity: 0.85;
  }

  .footer-description {
    margin: 0.75rem 0 0;
    color: rgba(215, 228, 239, 0.75);
    max-width: 32ch;
  }

  .footer-nav {
    display: grid;
    gap: 0.45rem;
  }

  .footer-nav a {
    color: rgba(215, 228, 239, 0.85);
    text-decoration: none;
    font-weight: 500;
  }

  .footer-nav a:hover {
    color: #fff;
  }

  .footer-contact {
    display: grid;
    gap: 0.45rem;
  }

  .footer-contact span {
    color: rgba(215, 228, 239, 0.75);
    font-size: 0.95rem;
  }

  .footer-contact a {
    color: #f4f9fb;
    text-decoration: none;
    font-weight: 600;
  }

  .footer-contact a:hover {
    text-decoration: underline;
  }

  .footer-meta {
    margin-top: 2rem;
    text-align: center;
    color: rgba(215, 228, 239, 0.55);
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    .footer-inner {
      text-align: center;
    }

    .footer-nav,
    .footer-contact {
      justify-items: center;
    }
  }
</style>
