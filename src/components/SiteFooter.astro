---
import {
  DEFAULT_BASE_LOCATION,
  DEFAULT_EMAIL,
  DEFAULT_PHONE_DISPLAY,
  DEFAULT_PHONE_NUMBER,
  DEFAULT_WHATSAPP_LINK,
} from "../utils/constants";
import { formatHourRange } from "../utils/helpers";
import type { BaseLocation, ContactInfo } from "../types/company";

interface SiteFooterProps {
  companyName?: string;
  tagline?: string;
  description?: string[] | null;
  contact?: ContactInfo | null;
  baseLocation?: BaseLocation | null;
  currentYear?: number;
}

const {
  companyName = "Ponyvet",
  tagline = "Veterinaria rural a domicilio",
  description,
  contact: rawContact,
  baseLocation,
  currentYear,
} = Astro.props as SiteFooterProps;

const contact = rawContact ?? ({} as ContactInfo);
const descriptionList = description ?? [];

const phoneNumber =
  contact.phone?.international ?? DEFAULT_PHONE_NUMBER;
const phoneDisplay = contact.phone?.display ?? DEFAULT_PHONE_DISPLAY;
const phoneHoursLabel = formatHourRange(contact.phone?.hours);

const whatsappLink =
  contact.whatsapp?.link ?? DEFAULT_WHATSAPP_LINK;
const whatsappHoursLabel = formatHourRange(contact.whatsapp?.hours);

const email = contact.email ?? DEFAULT_EMAIL;

const contactLocation =
  contact.baseLocation ??
  (baseLocation?.community && baseLocation?.state
    ? `${baseLocation.community}, ${baseLocation.state}`
    : DEFAULT_BASE_LOCATION);

const summaryParagraphs =
  descriptionList.length > 0
    ? descriptionList
    : [
        "Veterinaria móvil especializada en comunidades rurales del Valle Verde. Contigo los siete días de la semana.",
      ];

const displayYear = currentYear ?? new Date().getFullYear();
---
---

<footer>
  <div class="footer-inner">
    <div>
      <div class="footer-logo">{companyName}</div>
      <span class="footer-tagline">{tagline}</span>
      {summaryParagraphs.map((text) => (
        <p class="footer-description">
          {text}
        </p>
      ))}
    </div>
    <nav class="footer-nav" aria-label="Navegación secundaria">
      <a href="#inicio">Inicio</a>
      <a href="#servicios">Servicios</a>
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#beneficios">Beneficios</a>
      <a href="#testimonios">Testimonios</a>
      <a href="#cobertura">Cobertura</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <div class="footer-contact">
      {phoneNumber && phoneDisplay && (
        <span>
          Teléfono{phoneHoursLabel && ` (${phoneHoursLabel})`}:
          {' '}
          <a href={`tel:${phoneNumber}`}>{phoneDisplay}</a>
        </span>
      )}
      {whatsappLink && phoneDisplay && (
        <span>
          WhatsApp{whatsappHoursLabel && ` (${whatsappHoursLabel})`}:
          {' '}
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
            {phoneDisplay}
          </a>
        </span>
      )}
      {email && (
        <span>
          Correo:
          {' '}
          <a href={`mailto:${email}`}>{email}</a>
        </span>
      )}
      {contact.whatsapp?.notes && <span>{contact.whatsapp.notes}</span>}
      {contactLocation && <span>Ubicación base: {contactLocation}</span>}
    </div>
  </div>
  <p class="footer-meta">
    © {displayYear} {companyName}. Todos los derechos reservados.
  </p>
</footer>

<style>
  footer {
    background: #112433;
    color: #d7e4ef;
    padding: 3rem 0 2rem;
    margin-top: 6rem;
  }

  .footer-inner {
    width: min(1100px, 92vw);
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    align-items: start;
  }

  .footer-logo {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .footer-tagline {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f4f9fb;
    opacity: 0.85;
  }

  .footer-description {
    margin: 0.75rem 0 0;
    color: rgba(215, 228, 239, 0.75);
    max-width: 32ch;
  }

  .footer-nav {
    display: grid;
    gap: 0.45rem;
  }

  .footer-nav a {
    color: rgba(215, 228, 239, 0.85);
    text-decoration: none;
    font-weight: 500;
  }

  .footer-nav a:hover {
    color: #fff;
  }

  .footer-contact {
    display: grid;
    gap: 0.45rem;
  }

  .footer-contact span {
    color: rgba(215, 228, 239, 0.75);
    font-size: 0.95rem;
  }

  .footer-contact a {
    color: #f4f9fb;
    text-decoration: none;
    font-weight: 600;
  }

  .footer-contact a:hover {
    text-decoration: underline;
  }

  .footer-meta {
    margin-top: 2rem;
    text-align: center;
    color: rgba(215, 228, 239, 0.55);
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    .footer-inner {
      text-align: center;
    }

    .footer-nav,
    .footer-contact {
      justify-items: center;
    }
  }
</style>
