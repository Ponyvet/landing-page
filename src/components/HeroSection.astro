---
import Icon from "@components/Icon.astro";

const { whatsappLink } = Astro.props;

const highlights = [
  "Respuesta garantizada en menos de 24 horas dentro del Valle Verde",
  "Clínica móvil equipada para ganado, equinos y mascotas rurales",
  "Atendemos de lunes a domingo de 8:00 a 19:00 hrs",
];

const stats = [
  { value: "+350", label: "visitas a campo cada año" },
  { value: "96%", label: "casos resueltos sin traslado" },
];
---

<section class="hero" id="inicio">
  <div class="hero-content">
    <span class="eyebrow">Veterinaria rural a domicilio</span>
    <h1>Ponyvet llega a tu rancho para cuidar a tus animales</h1>
    <p>
      Consultas preventivas, seguimiento sanitario y atención a urgencias dentro
      de nuestro horario extendido. Nuestro equipo móvil llega directamente a tu
      rancho o comunidad con el equipamiento necesario.
    </p>
    <div class="cta-group">
      <a
        class="cta primary"
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="message-circle" class="icon" size={20} aria-hidden="true" />
        Agenda por WhatsApp
      </a>
      <a class="cta secondary" href="#servicios">
        <Icon name="arrow-down" class="icon" size={20} aria-hidden="true" />
        Ver servicios
      </a>
    </div>
    <ul class="hero-highlights">
      {
        highlights.map((highlight) => (
          <li key={highlight}>
            <Icon name="check" class="list-icon" size={18} aria-hidden="true" />
            {highlight}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="hero-card">
    <h2>Equipo veterinario móvil Ponyvet</h2>
    <p>
      Programamos visitas y atendemos urgencias dentro del horario sin que
      traslades a tus animales.
    </p>
    <dl class="stats">
      {
        stats.map((item) => (
          <div>
            <dt>{item.value}</dt>
            <dd>{item.label}</dd>
          </div>
        ))
      }
    </dl>
    <p class="small">Horario de atención: 8:00 a 19:00 hrs, todos los días.</p>
  </div>
</section>

<style>
  .hero {
    width: min(1100px, 92vw);
    margin: 0 auto;
    padding-top: 2rem;
    display: grid;
    gap: 3rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary);
  }

  .hero-content h1 {
    margin: 0;
    font-size: clamp(2.45rem, 2.4rem + 1vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero-content p {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 2rem 0;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease,
      color 0.25s ease;
  }

  .cta.primary {
    background: var(--primary);
    color: #fff;
    box-shadow: var(--shadow);
  }

  .cta.primary:hover {
    transform: translateY(-2px);
    background: var(--primary-dark);
  }

  .cta.secondary {
    background: rgba(42, 111, 151, 0.12);
    color: var(--primary-dark);
  }

  .cta.secondary:hover {
    background: rgba(42, 111, 151, 0.22);
  }

  .cta .icon {
    width: 1.1rem;
    height: 1.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hero-highlights {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .hero-highlights li {
    background: var(--surface);
    border-radius: 16px;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: 0 18px 40px -30px rgba(17, 34, 44, 0.45);
    font-weight: 500;
  }

  .hero-highlights .list-icon {
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    background: rgba(42, 111, 151, 0.12);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem;
    color: var(--primary);
  }

  .hero-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(155deg, #2a6f97 0%, #1e4d68 90%);
    color: #eff6fa;
    padding: 2.5rem;
    border-radius: 28px;
    box-shadow: 0 32px 60px -40px rgba(14, 40, 56, 0.65);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-card::after {
    content: "";
    position: absolute;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: rgba(242, 166, 90, 0.25);
    top: -70px;
    right: -80px;
  }

  .hero-card h2 {
    margin: 0;
    font-size: 2rem;
    letter-spacing: -0.01em;
  }

  .hero-card p {
    margin: 0;
    color: rgba(239, 247, 250, 0.85);
  }

  .hero-card .stats {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
  }

  .hero-card .stats div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero-card dt {
    margin: 0;
    font-weight: 700;
    font-size: 2.4rem;
    color: #fff;
  }

  .hero-card dd {
    margin: 0;
    color: rgba(239, 247, 250, 0.75);
    font-size: 0.9rem;
  }

  .hero-card .small {
    font-size: 0.85rem;
    color: rgba(239, 247, 250, 0.7);
  }

  @media (max-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .hero-highlights {
      gap: 0.65rem;
    }

    .cta-group {
      flex-direction: column;
      align-items: stretch;
    }

    .cta {
      justify-content: center;
      width: 100%;
    }

    .hero-card {
      padding: 2rem;
    }
  }
</style>
