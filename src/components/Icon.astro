---
import {
  ArrowDown,
  Beaker,
  BriefcaseMedical,
  Check,
  ClipboardCheck,
  Mail,
  MessageCircle,
  PawPrint,
  Smartphone,
} from "@lucide/astro";

const icons = {
  "arrow-down": ArrowDown,
  beaker: Beaker,
  "briefcase-medical": BriefcaseMedical,
  check: Check,
  "clipboard-check": ClipboardCheck,
  mail: Mail,
  "message-circle": MessageCircle,
  "paw-print": PawPrint,
  smartphone: Smartphone,
} as const;

type IconName = keyof typeof icons;

type IconProps = {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
} & Record<string, unknown>;

const props = Astro.props as IconProps;

const {
  name,
  size = 24,
  strokeWidth: strokeWidthValue = 1.75,
  class: className = "",
  ...rest
} = props;

const IconComponent = icons[name];

if (!IconComponent) {
  throw new Error(`Icon "${name}" no definido.`);
}
---

<IconComponent
  size={size}
  stroke-width={strokeWidthValue}
  class={className || undefined}
  {...rest}
/>
