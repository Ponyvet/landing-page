---
import {
  Beef,
  Bird,
  CalendarDays,
  Cat,
  Check,
  ChevronDown,
  Clock,
  Dog,
  Mail,
  MapPin,
  MessageCircle,
  PawPrint,
  Phone,
  PiggyBank,
  Stethoscope,
  Truck,
} from "@lucide/astro";

const icons = {
  beef: Beef,
  bird: Bird,
  "calendar-days": CalendarDays,
  cat: Cat,
  check: Check,
  "chevron-down": ChevronDown,
  clock: Clock,
  dog: Dog,
  mail: Mail,
  "map-pin": MapPin,
  "message-circle": MessageCircle,
  "paw-print": PawPrint,
  phone: Phone,
  "piggy-bank": PiggyBank,
  stethoscope: Stethoscope,
  truck: Truck,
} as const;

type IconName = keyof typeof icons;

type IconProps = {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
} & Record<string, unknown>;

const props = Astro.props as IconProps;

const {
  name,
  size = 24,
  strokeWidth: strokeWidthValue = 1.75,
  class: className = "",
  ...rest
} = props;

const IconComponent = icons[name];

if (!IconComponent) {
  throw new Error(`Icon "${name}" no definido.`);
}
---

<IconComponent
  size={size}
  stroke-width={strokeWidthValue}
  class={className || undefined}
  {...rest}
/>
