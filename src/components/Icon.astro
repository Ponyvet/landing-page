---
import {
        ArrowDown,
        Beaker,
        BriefcaseMedical,
        Check,
        ClipboardCheck,
        Mail,
        MessageCircle,
        PawPrint,
        Smartphone,
} from '@lucide/astro';

const {
        name,
        size = 24,
        strokeWidth = 1.75,
        class: className = '',
        ...rest
} = Astro.props;

const icons = {
        'arrow-down': ArrowDown,
        beaker: Beaker,
        'briefcase-medical': BriefcaseMedical,
        check: Check,
        'clipboard-check': ClipboardCheck,
        mail: Mail,
        'message-circle': MessageCircle,
        'paw-print': PawPrint,
        smartphone: Smartphone,
} as const;

const IconComponent = icons[name as keyof typeof icons];

if (!IconComponent) {
        throw new Error(`Icon "${name}" no definido.`);
}
---
<IconComponent
        size={size}
        strokeWidth={strokeWidth}
        class={className || undefined}
        {...rest}
/>
