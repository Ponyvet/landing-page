---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  class?: string;
}

const { eyebrow, title, lead, class: className } = Astro.props;
---

<div class:list={["section-title", className]}>
  {eyebrow && <span class="section-title-eyebrow">{eyebrow}</span>}
  <h2 class="section-title-heading">{title}</h2>
  {lead && <p class="section-title-lead">{lead}</p>}
</div>

<style>
  .section-title {
    display: grid;
    gap: 12px;
    max-width: 46rem;
    margin-bottom: 2.5rem;
  }

  .section-title-eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--primary);
  }

  .section-title-heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
  }

  .section-title-lead {
    font-size: var(--text-lg);
    color: var(--muted-foreground);
  }
</style>
