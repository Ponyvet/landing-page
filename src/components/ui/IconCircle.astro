---
import Icon from "@components/Icon.astro";

interface Props {
  name: string;
  size?: number;
  tone?: "primary" | "accent";
}

const { name, size = 22, tone = "primary" } = Astro.props;
---

<span class:list={["icon-circle", `icon-circle-${tone}`]}>
  <Icon name={name} size={size} />
</span>

<style>
  .icon-circle {
    display: grid;
    place-items: center;
    padding: 12px;
    border-radius: var(--radius-full);
  }

  .icon-circle-primary {
    background: color-mix(in oklch, var(--primary) 10%, transparent);
    color: var(--primary);
  }

  .icon-circle-accent {
    background: color-mix(in oklch, var(--accent) 20%, transparent);
    color: var(--pv-gold-600);
  }
</style>
