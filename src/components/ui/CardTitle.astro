---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["card-title", className]}>
  <slot />
</div>

<style>
  .card-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }
</style>
