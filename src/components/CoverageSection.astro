---
type ServiceHours = {
  days?: string;
  opening?: string;
  closing?: string;
  notes?: string[];
};

type ContactDetails = {
  phone?: {
    international?: string;
    display?: string;
    hours?: string | null;
  };
  whatsapp?: {
    link?: string;
    hours?: string | null;
  };
  email?: string;
  baseLocation?: string;
};

type BaseLocation = {
  community?: string;
  state?: string;
};

type CoverageDetails = {
  areas?: string[];
  radius?: string;
  travelPolicy?: string;
};

type CoverageProps = {
  coverage?: CoverageDetails;
  serviceHours?: ServiceHours;
  contact?: ContactDetails;
  baseLocation?: BaseLocation;
};

const { coverage, serviceHours, contact, baseLocation } =
  Astro.props satisfies CoverageProps;

const coverageAreas = coverage?.areas ?? [];
const coverageRadius = coverage?.radius;
const travelPolicy = coverage?.travelPolicy;

const phoneNumber = contact?.phone?.international;
const phoneDisplay = contact?.phone?.display;
const phoneHours = contact?.phone?.hours ?? null;
const whatsappLink = contact?.whatsapp?.link;
const whatsappHours = contact?.whatsapp?.hours ?? null;
const email = contact?.email;

const formatHourRange = (value: string | null | undefined): string | null => {
  if (!value) return null;
  const trimmed = value.trim();

  if (trimmed.includes("-")) {
    const [start, end] = trimmed.split("-").map((segment) => segment.trim());
    if (start && end) {
      return `${start} a ${end} hrs`;
    }
  }

  return trimmed;
};

const serviceNotes = serviceHours
  ? [
      serviceHours.days && serviceHours.opening && serviceHours.closing
        ? `${serviceHours.days}: ${serviceHours.opening} - ${serviceHours.closing} hrs`
        : serviceHours.days,
      ...(serviceHours.notes ?? []),
    ].filter((note): note is string => Boolean(note))
  : [];

const baseArea =
  baseLocation?.community && baseLocation?.state
    ? `${baseLocation.community}, ${baseLocation.state}`
    : contact?.baseLocation;
const defaultCoverageAreas = [
  "Valle Verde",
  "San Miguel de la Sierra",
  "La Esperanza",
  "Rancho El Encino",
  "Puente de Piedra",
  "Santa Lucía",
];

const coverageAreasToDisplay: string[] =
  coverageAreas.length > 0 ? coverageAreas : defaultCoverageAreas;

const coverageRadiusLabel =
  coverageRadius ?? "50 km alrededor del Valle Verde";

const travelPolicyLabel =
  travelPolicy ?? "Sin costo de desplazamiento hasta 30 km";

const defaultServiceNotes = [
  "Lunes a domingo: 8:00 - 19:00 hrs",
  "Visitas programadas y atención urgente dentro del horario",
  "Confirmación previa vía WhatsApp",
];

const notesToDisplay: string[] =
  serviceNotes.length > 0 ? serviceNotes : defaultServiceNotes;

const baseAreaLabel = baseArea ?? "Valle Verde, Querétaro";

const whatsappHoursLabel = formatHourRange(whatsappHours);
const phoneHoursLabel = formatHourRange(phoneHours);
---

<section id="cobertura" class="coverage">
  <div class="coverage-text">
    <h2>Zona de cobertura</h2>
    <p>
      Atendemos domicilios  dentro de un radio de
      {coverageRadiusLabel}. Nuestra base está en {baseAreaLabel} y llegamos 
      hasta tu comunidad.
    </p>
    <ul class="coverage-list">
      {coverageAreasToDisplay.map((area) => (
        <li>{area}</li>
      ))}
    </ul>
  </div>
  <div class="coverage-panels">
    <div class="panel">
      <h3>Horarios de visita</h3>
      <ul>
        {notesToDisplay.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
    <div class="panel">
      <h3>Contactos directos</h3>
      <p>
        Resolvemos dudas y programamos visitas durante el horario de atención.
      </p>
      {phoneNumber && phoneDisplay && (
        <a href={`tel:${phoneNumber}`}>
          Llamada directa {phoneDisplay}
        </a>
      )}
      {whatsappLink && (
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
      )}
      {email && <a href={`mailto:${email}`}>{email}</a>}
    </div>
  </div>
</section>

<style>
  .coverage {
    width: min(1100px, 92vw);
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    align-items: start;
  }

  .coverage-text {
    background: var(--surface);
    border-radius: 28px;
    padding: 2.5rem;
    box-shadow: 0 28px 70px -45px rgba(17, 34, 44, 0.45);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .coverage-text p {
    margin: 0;
    color: var(--muted);
  }

  .coverage-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  }

  .coverage-list li {
    background: rgba(42, 111, 151, 0.12);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-weight: 600;
    color: var(--primary-dark);
    text-align: center;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    font-size: 0.75rem;
  }

  .coverage-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(242, 166, 90, 0.25);
    color: var(--primary-dark);
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .coverage-panels {
    display: grid;
    gap: 1.5rem;
  }

  .panel {
    background: var(--surface);
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 24px 60px -42px rgba(17, 34, 44, 0.45);
    display: grid;
    gap: 0.75rem;
  }

  .panel h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .panel ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    display: grid;
    gap: 0.35rem;
    font-size: 0.95rem;
  }

  .panel p {
    margin: 0;
    color: var(--muted);
  }

  .panel a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
  }

  .panel a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .coverage {
      grid-template-columns: 1fr;
    }

    .coverage-text,
    .panel {
      padding: 1.5rem;
    }
  }
</style>
