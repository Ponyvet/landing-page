---
import {
  COVERAGE_DEFAULT_AREAS,
  COVERAGE_DEFAULT_RADIUS,
  COVERAGE_DEFAULT_SERVICE_NOTES,
  COVERAGE_DEFAULT_TRAVEL_POLICY,
  DEFAULT_BASE_LOCATION,
} from "../utils/constants";
import { formatHourRange } from "../utils/helpers";
import type {
  BaseLocation,
  ContactInfo,
  CoverageInfo,
  ServiceHours,
} from "../types/company";

interface CoverageSectionProps {
  coverage?: CoverageInfo | null;
  serviceHours?: ServiceHours | null;
  contact?: ContactInfo | null;
  baseLocation?: BaseLocation | null;
}

const {
  coverage: rawCoverage,
  serviceHours,
  contact: rawContact,
  baseLocation,
} = Astro.props as CoverageSectionProps;

const coverage = rawCoverage ?? ({} as CoverageInfo);
const contact = rawContact ?? ({} as ContactInfo);

const coverageAreas = coverage.areas ?? [];
const coverageRadius = coverage.radius;
const travelPolicy = coverage.travelPolicy;

const phoneNumber = contact.phone?.international;
const phoneDisplay = contact.phone?.display;
const phoneHours = contact.phone?.hours;
const whatsappLink = contact.whatsapp?.link;
const whatsappHours = contact.whatsapp?.hours;
const email = contact.email;

const serviceNotes = serviceHours
  ? [
      serviceHours.days && serviceHours.opening && serviceHours.closing
        ? `${serviceHours.days}: ${serviceHours.opening} - ${serviceHours.closing} hrs`
        : serviceHours.days,
      ...(serviceHours.notes ?? []),
    ].filter((note): note is string => Boolean(note))
  : [];

const baseArea =
  baseLocation?.community && baseLocation?.state
    ? `${baseLocation.community}, ${baseLocation.state}`
    : contact.baseLocation;

const coverageAreasToDisplay =
  coverageAreas.length > 0 ? coverageAreas : COVERAGE_DEFAULT_AREAS;

const coverageRadiusLabel =
  coverageRadius ?? COVERAGE_DEFAULT_RADIUS;

const travelPolicyLabel =
  travelPolicy ?? COVERAGE_DEFAULT_TRAVEL_POLICY;

const notesToDisplay =
  serviceNotes.length > 0 ? serviceNotes : COVERAGE_DEFAULT_SERVICE_NOTES;

const baseAreaLabel = baseArea ?? DEFAULT_BASE_LOCATION;

const whatsappHoursLabel = formatHourRange(whatsappHours);
const phoneHoursLabel = formatHourRange(phoneHours);
---

<section id="cobertura" class="coverage">
  <div class="coverage-text">
    <h2>Zona de cobertura</h2>
    <p>
      Atendemos ranchos, ejidos y comunidades dentro de un radio de
      {coverageRadiusLabel}. Nuestra base está en {baseAreaLabel} y llegamos con
      unidades 4x4 y kits completos de atención.
    </p>
    <ul class="coverage-list">
      {coverageAreasToDisplay.map((area) => (
        <li>{area}</li>
      ))}
    </ul>
    <span class="coverage-badge">{travelPolicyLabel}</span>
  </div>
  <div class="coverage-panels">
    <div class="panel">
      <h3>Horarios de visita</h3>
      <ul>
        {notesToDisplay.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
    <div class="panel">
      <h3>Contactos directos</h3>
      <p>
        Resolvemos dudas y programamos visitas durante el horario de atención.
      </p>
      {phoneNumber && phoneDisplay && (
        <a href={`tel:${phoneNumber}`}>
          Llamada directa {phoneDisplay}
          {phoneHoursLabel && ` (${phoneHoursLabel})`}
        </a>
      )}
      {whatsappLink && (
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
          WhatsApp{whatsappHoursLabel && ` (${whatsappHoursLabel})`}
        </a>
      )}
      {email && <a href={`mailto:${email}`}>{email}</a>}
    </div>
  </div>
</section>

<style>
  .coverage {
    width: min(1100px, 92vw);
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    align-items: start;
  }

  .coverage-text {
    background: var(--surface);
    border-radius: 28px;
    padding: 2.5rem;
    box-shadow: 0 28px 70px -45px rgba(17, 34, 44, 0.45);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .coverage-text p {
    margin: 0;
    color: var(--muted);
  }

  .coverage-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  }

  .coverage-list li {
    background: rgba(42, 111, 151, 0.12);
    border-radius: 999px;
    padding: 0.65rem 1rem;
    font-weight: 600;
    color: var(--primary-dark);
    text-align: center;
  }

  .coverage-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(242, 166, 90, 0.25);
    color: var(--primary-dark);
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .coverage-panels {
    display: grid;
    gap: 1.5rem;
  }

  .panel {
    background: var(--surface);
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 24px 60px -42px rgba(17, 34, 44, 0.45);
    display: grid;
    gap: 0.75rem;
  }

  .panel h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .panel ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    display: grid;
    gap: 0.35rem;
    font-size: 0.95rem;
  }

  .panel p {
    margin: 0;
    color: var(--muted);
  }

  .panel a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
  }

  .panel a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .coverage {
      grid-template-columns: 1fr;
    }

    .coverage-text,
    .panel {
      padding: 1.5rem;
    }
  }
</style>
