---
import Section from "@components/ui/Section.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import Badge from "@components/ui/Badge.astro";
import Card from "@components/ui/Card.astro";
import CardHeader from "@components/ui/CardHeader.astro";
import CardContent from "@components/ui/CardContent.astro";
import Separator from "@components/ui/Separator.astro";
import IconRow from "@components/ui/IconRow.astro";

type ServiceHours = {
  days?: string;
  opening?: string;
  closing?: string;
  notes?: string[];
};

type CoverageDetails = {
  areas?: string[];
  radius?: string;
  travelPolicy?: string;
};

interface Props {
  coverage?: CoverageDetails;
  serviceHours?: ServiceHours;
}

const { coverage, serviceHours } = Astro.props satisfies Props;

const areas = coverage?.areas ?? [];
const radiusLabel = coverage?.radius ?? "30 km desde San Salvador, Hidalgo";
const travelPolicy =
  coverage?.travelPolicy ?? "Sin costo de traslado dentro de los primeros 30 km";
const notes = serviceHours?.notes ?? [];
const days = serviceHours?.days ?? "Lunes a domingo";
const hoursLabel =
  serviceHours?.opening && serviceHours?.closing
    ? `${serviceHours.opening} – ${serviceHours.closing}`
    : null;
---

<Section id="cobertura" background="muted" ariaLabel="Cobertura">
  <div class="coverage-grid">
    <div>
      <SectionTitle
        eyebrow="Cobertura"
        title={radiusLabel}
        lead={travelPolicy}
      />
      <div class="area-list">
        {areas.map((area) => (
          <Badge variant="outline" class="area-badge" icon="map-pin">{area}</Badge>
        ))}
      </div>
    </div>
    <Card>
      <CardHeader bordered class="hours-header">
        <span class="hours-title">Horario de atención</span>
      </CardHeader>
      <CardContent>
        {hoursLabel && (
          <div class="hours-row">
            <span class="hours-days">{days}</span>
            <span class="hours-value">{hoursLabel}</span>
          </div>
        )}
        <Separator />
        {notes.map((note) => (
          <IconRow icon="check">{note}</IconRow>
        ))}
      </CardContent>
    </Card>
  </div>
</Section>

<style>
  .coverage-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .area-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /*
    Astro scopes Badge's own rules with a higher-specificity data
    attribute, so a plain :global(.area-badge) override loses to
    .badge-outline. Repeating the class beats that without touching
    the shared Badge component.
  */
  :global(.area-badge.area-badge.area-badge) {
    background: var(--card);
    font-size: var(--text-sm);
  }

  .hours-header {
    display: flex;
    align-items: center;
  }

  .hours-title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  .hours-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .hours-days {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .hours-value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--primary);
  }

  @media (max-width: 900px) {
    .coverage-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
