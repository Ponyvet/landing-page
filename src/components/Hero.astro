---
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";

type Stat = {
  value: string;
  label: string;
};

type BaseLocation = {
  community?: string;
  state?: string;
};

interface Props {
  tagline?: string;
  description?: string[];
  stats?: Stat[];
  whatsappLink?: string;
  phoneNumber?: string;
  phoneDisplay?: string;
  baseLocation?: BaseLocation;
  coverageRadius?: string;
}

const {
  tagline = "Veterinaria rural a domicilio",
  description = [],
  stats = [],
  whatsappLink = "https://wa.me/527721541841",
  phoneNumber,
  phoneDisplay,
  baseLocation,
  coverageRadius,
} = Astro.props satisfies Props;

const locationLabel =
  baseLocation?.community && baseLocation?.state
    ? `${baseLocation.community}, ${baseLocation.state}`
    : "San Salvador, Hidalgo";

const radiusLabel = coverageRadius?.match(/\d+\s*km/i)?.[0] ?? "30 km";
---

<section class="hero" id="inicio">
  <div class="hero-grid">
    <div class="hero-content">
      <Badge variant="accent" icon="map-pin">
        {locationLabel} · {radiusLabel} a la redonda
      </Badge>
      <h1 class="hero-title">{tagline}</h1>
      {description.map((paragraph) => <p class="hero-description">{paragraph}</p>)}
      <div class="hero-cta">
        <Button
          size="lg"
          icon="whatsapp"
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          Agenda tu cita
        </Button>
        {phoneNumber && phoneDisplay && (
          <Button size="lg" variant="outline" icon="phone" href={`tel:${phoneNumber}`}>
            {phoneDisplay}
          </Button>
        )}
      </div>
    </div>
    <div class="hero-record">
      <span class="hero-record-eyebrow">Ficha de cobertura</span>
      <img src="/brand/isotype-teal.png" alt="" class="hero-record-mark" />

      <div class="hero-record-rows">
        {stats.map((stat) => (
          <div class="record-row">
            <span class="record-value">{stat.value}</span>
            <span class="record-leader" aria-hidden="true" />
            <span class="record-label">{stat.label}</span>
          </div>
        ))}
      </div>

      <span class="hero-stamp" aria-hidden="true">
        <span>{radiusLabel}</span>
        <span>a la redonda</span>
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--secondary);
    border-bottom: 1px solid var(--border);
  }

  .hero-grid {
    max-width: var(--section-max);
    margin: 0 auto;
    padding: 5.5rem 1.5rem;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: start;
  }

  .hero-content {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-top: 0.5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: var(--weight-extrabold);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--pv-navy-700);
    max-width: 20ch;
    margin: 0;
  }

  .hero-description {
    font-size: var(--text-lg);
    color: var(--muted-foreground);
    max-width: 34rem;
    margin: 0;
  }

  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Record card — styled like the visit ficha a rural vet fills out on-site */
  .hero-record {
    position: relative;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    padding: 1.75rem 1.5rem 2rem;
    display: grid;
    gap: 1.25rem;
    overflow: hidden;
  }

  .hero-record-eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--primary);
  }

  .hero-record-mark {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 3rem;
    height: 3rem;
    opacity: 0.14;
  }

  .hero-record-rows {
    display: grid;
    gap: 0.85rem;
  }

  .record-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .record-value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--primary);
    flex-shrink: 0;
  }

  .record-leader {
    flex: 1 1 auto;
    min-width: 12px;
    border-bottom: 1px dotted var(--border);
    margin-bottom: 6px;
  }

  .record-label {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    text-align: right;
    max-width: 12rem;
  }

  .hero-stamp {
    justify-self: center;
    margin-top: 0.25rem;
    width: 7.5rem;
    height: 7.5rem;
    border-radius: var(--radius-full);
    border: 2px dashed var(--pv-teal-500);
    display: grid;
    place-items: center;
    text-align: center;
    transform: rotate(-9deg);
    color: var(--pv-teal-700);
  }

  .hero-stamp span:first-child {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-extrabold);
    text-transform: uppercase;
    line-height: 1.1;
  }

  .hero-stamp span:last-child {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      padding-top: 3rem;
    }

    .hero-record {
      max-width: 26rem;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
